# Copie para .env (local) ou cadastre no painel da Hostinger (Node.js > Variáveis de ambiente).
# NUNCA commite valores reais.
NODE_ENV=production
APP_USER=
# Gere com: npm run hash   (pede a senha e imprime APP_PASS_HASH e SESSION_SECRET)
APP_PASS_HASH=
SESSION_SECRET=
# Opcional (2FA): npm run hash -- --totp
TOTP_SECRET=
SESSION_HOURS=12

# Gestão de risco (padrões do botão Gerar operação)
RISK_CAPITAL=100000
RISK_MAX_PCT=2

# Pasta de dados (diário e histórico de VI) — fora da pasta do app
DATA_DIR=

# Provedores opcionais (o sistema funciona sem eles, em modo teórico)
OPLAB_TOKEN=
TRADIER_TOKEN=
TRADIER_ENV=sandbox
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
